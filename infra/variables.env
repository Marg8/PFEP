# ============================================================
# Edita estos valores antes de ejecutar setup-gcp.sh
# ============================================================

PROJECT_ID="tu-proyecto-gcp"        # ID del proyecto en Google Cloud
REGION="us-central1"                 # Región de Cloud Run

# Red interna (tu empresa)
CORP_VPN_IP="X.X.X.X"              # IP pública del router/firewall corporativo
CORP_CIDR="10.0.0.0/8"             # CIDR de tu red interna (ej. 192.168.0.0/16)
CORP_DB_IP="10.X.X.X"              # IP interna de mtapp05

# VPN shared secret (debe coincidir con el configurado en tu router)
VPN_SHARED_SECRET="cambia_este_secreto_seguro"

# Nombres de recursos GCP (puedes dejarlos igual)
VPC_NAME="pfep-vpc"
SUBNET_CIDR="10.8.0.0/28"          # /28 requerido para VPC Connector
ROUTER_NAME="pfep-router"
VPN_GW_NAME="pfep-vpn-gw"
TUNNEL_NAME="pfep-tunnel"
CONNECTOR_NAME="pfep-connector"
SERVICE_NAME="pfep-app"
